projection;
strict ( 2 );
use draft;
use side effects;

define behavior for ZC_railway_ord alias railway_ord
{
  use create;
  use update;
  use delete;

  use action FetchOrderData;
  use action SubmitAndPost;
  use action CancelConfirmation;
  use action PostRejection;
  use action CancelRejection;

  use action Edit;
  use action Activate;
  use action Resume;
  use action Discard;
  use action Prepare;

  use association _ScrapItems { create; with draft; }
  use association _Activities { create; with draft; }
  use association _REJECTION { create; with draft; }
}

define behavior for ZC_railway_ACT alias Activity
{
  use update;
  use delete;

  use association _OrderConfirmation { with draft; }
}

define behavior for ZC_railway_SCP alias ScrapItem
{
  use update;
  use delete;

  use association _OrderConfirmation { with draft; }
}


define behavior for ZC_RAIL_REJ alias Rejection
{
  use update;
  use delete;

  use association _OrderConfirmation { with draft; }
}